{
  "appId": "app.arin.dev",
  "appName": "arin 개발",
  "webDir": "dist",
  "backgroundColor": "#F7F6F2",
  "android": {
    "webContentsDebuggingEnabled": true
  },
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#F7F6F2",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    }
  }
}
