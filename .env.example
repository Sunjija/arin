# 계정 API 환경변수 예시
# 복사해서 `.env.local` 또는 셸에서 export 한다. 값을 채웠다고 운영 연결이 된 것은 아니다.

# development | test | production
ARIN_ENV=development

# Vite 미들웨어로 API를 붙이려면 1
ARIN_ACCOUNT_API=1

# 클라이언트 모드. demo(기본) | connected
VITE_ARIN_ACCOUNT_MODE=connected

# 선택. 비우면 같은 출처 /api/account/v1 을 쓴다.
# VITE_ARIN_API_BASE=http://127.0.0.1:43128

# SQLite 파일. 기본값: server/data/arin-account.sqlite
# ARIN_SQLITE_PATH=server/data/arin-account.sqlite

# 독립 실행 서버 포트 (npm run account:api)
# ARIN_API_PORT=43128
# ARIN_API_HOST=127.0.0.1

# 브라우저 Origin. 쿠키·CORS에 사용
ARIN_PUBLIC_ORIGIN=http://127.0.0.1:43127

# 결제 서버만 사용하는 관리자 키. 앱 번들·VITE_ 에 넣지 말 것.
# 비우면 관리자 API는 403.
# ARIN_ADMIN_KEY=

# 개발에서만. 테스트 계정 a@arin.test / b@arin.test 시드
ARIN_ALLOW_TEST_SEED=1

# 개발에서만. 복구 토큰을 JSON 응답에 포함. production에서는 무시된다.
ARIN_DEV_RECOVERY=1

# ARIN_DEV_MAILBOX_PATH=server/data/dev-mailbox.json
