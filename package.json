{
  "name": "hanguksa-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "dev:live": "vite --mode live",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "build:live": "tsc -b && vite build --mode live",
    "lint": "oxlint src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect:questions": "vitest run src/data/inspectQuestions.test.ts",
    "typecheck": "tsc -b --pretty false",
    "mobile:icons": "node scripts/generate-mobile-icons.mjs && node scripts/apply-mobile-assets.mjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android:sync": "npm run build && cap sync android",
    "mobile:android:apk": "bash scripts/build-android-debug.sh",
    "mobile:ios:sync": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "dexie": "^4.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
