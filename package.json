{
  "name": "hanguksa-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:account": "ARIN_ACCOUNT_API=1 ARIN_ENV=development ARIN_ALLOW_TEST_SEED=1 ARIN_DEV_RECOVERY=1 VITE_ARIN_ACCOUNT_MODE=connected vite",
    "account:api": "tsx server/account-api/standalone.ts",
    "account:seed": "ARIN_ALLOW_TEST_SEED=1 tsx server/account-api/seed-cli.ts",
    "account:backup": "tsx server/account-api/backup.ts",
    "account:restore": "tsx server/account-api/backup.ts restore",
    "build": "tsc -b && vite build",
    "lint": "oxlint src server",
    "preview": "vite preview",
    "preview:account": "ARIN_ACCOUNT_API=1 ARIN_ENV=development ARIN_ALLOW_TEST_SEED=1 VITE_ARIN_ACCOUNT_MODE=connected vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect:questions": "vitest run src/data/inspectQuestions.test.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "dexie": "^4.4.5",
    "hono": "^4.11.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
